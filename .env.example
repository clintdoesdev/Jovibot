# ════════════════════════════════════════════════════════════════
# Jovia Network Telegram Bot — environment variables
# Copy this file to .env (or set these directly in Railway/host env
# vars) and fill in the values marked REQUIRED.
# ════════════════════════════════════════════════════════════════

# ── Telegram API credentials (REQUIRED) ───────────────────────────
# Get these from https://my.telegram.org -> API Development Tools.
API_ID=
API_HASH=

# ── Telegram user session (REQUIRED after first run) ──────────────
# Leave empty on the very first run. The bot will prompt for your
# phone number/code/2FA in the terminal and print a SESSION_STRING —
# copy that value here (and into your host's env vars) so future
# restarts don't need to log in again. Never share this string; it's
# equivalent to your Telegram login.
SESSION_STRING=

# ── Registration link + pricing ────────────────────────────────────
# The Jovia registration/payments page. Quoted in the signup message
# and reminder.
SIGNUP_URL=https://joviawebsite.com.ng

# One-time registration fee for each package. Shown in the welcome
# message, signup message, and reminder.
GOLD_FEE=₦15,000
SILVER_FEE=₦9,000

# ── Web Push notifications (optional) ──────────────────────────────
# Generate a VAPID key pair (e.g. `vapid --gen`, from the pywebpush
# package, or https://web-push-codelab.glitch.me/) to enable browser
# push alerts from the dashboard when someone "Needs Your Reply".
# Leave both empty to disable push notifications.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ── Dashboard / server ─────────────────────────────────────────────
# Port the FastAPI dashboard listens on. Railway sets this
# automatically — you usually don't need to set it yourself.
PORT=8080

# Where chat progress + the pending-reply queue are persisted to
# disk, so a redeploy/restart doesn't lose anyone's place in the
# funnel. Point this at a mounted persistent volume path in
# production (e.g. a Railway Volume) — otherwise state is lost on
# every redeploy.
STATE_FILE=bot_state.json

# ── Testing ─────────────────────────────────────────────────────────
# Comma-separated Telegram @usernames that always get a live reply
# from the bot, bypassing owner-silence and the pause switch — handy
# for testing the funnel from a second account. These accounts can
# also message "stats" for a live stats summary, "reset" to wipe
# their own saved progress, or send a message that STARTS with "_"
# (e.g. "_" or "_hi") — or, for backwards compatibility, ENDS with
# ">>" — to reset AND immediately replay the welcome message in one go.
#
# IMPORTANT: an account only has a @username if one was set in
# Telegram (Settings -> Username) — if your test account never set
# one, this can never match it no matter what you put here. Use
# TEST_CHAT_IDS below instead in that case.
TEST_USERNAMES=

# Comma-separated numeric Telegram user IDs — same test-account bypass
# as TEST_USERNAMES above, but for accounts with no @username set.
# Get your own numeric ID by messaging @userinfobot on Telegram from
# the account you want to test with, or by checking the "(id ...)" in
# a bot log line / "Needs Your Reply" card the first time that account
# messages the bot.
TEST_CHAT_IDS=

# Safety cap on the startup "catch-up" pass — if more than this many
# contacts look unreplied-to at boot, the bot queues them all for a
# manual look instead of auto-messaging everyone (this is usually the
# sign of lost state, e.g. STATE_FILE not on persistent storage).
CATCH_UP_SAFETY_CAP=10

# ── Social-referral flow (optional, off by default) ────────────────
# When enabled, openers like "From Facebook, I'm interested in
# getting started with Jovia" get a shorter dedicated script (welcome
# -> ask name -> subtle explanation + Telegram channel link) instead
# of the main funnel. Off by default — such openers are still counted
# in stats either way.
FACEBOOK_FLOW_ENABLED=false

# Public Telegram channel link sent at the end of the social-referral
# flow, if enabled above.
SOCIAL_CHANNEL_URL=https://t.me/joviaofficial
